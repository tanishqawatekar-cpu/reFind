# ReFind — Smart Campus Lost & Found System
# Environment Configuration (.env.example)

FLASK_SECRET_KEY=your_flask_secret_key_here
FLASK_ENV=development
FLASK_PORT=5000

# MySQL 8+ / 26.7 Database Connection Settings (Port 3307)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=refind_db

# Dedicated Flask Application User (Least-Privilege Runtime Account)
DB_USER=refind_app
DB_PASSWORD=your_refind_app_password_here

# Initial Setup Admin Account (Used ONLY by database/init_db.py)
DB_ROOT_USER=root
DB_ROOT_PASSWORD=your_mysql_root_password_here

# Optional Local Seed Passwords (Used ONLY by database/init_db.py when seeding sample users)
DEMO_ADMIN_PASSWORD=your_local_demo_admin_password
DEMO_STUDENT_PASSWORD=your_local_demo_student_password

# Image Upload Settings
MAX_UPLOAD_MB=5
